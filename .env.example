JUDGE_SERVER_URL=http://localhost:8081
# 判题机 token：自己生成，不要用固定值。
#   TOKEN=$(openssl rand -hex 32)
#   echo "JUDGE_SERVER_TOKEN=$TOKEN" >> .env          # 后端读这里
#   echo "OJ2_JUDGE_TOKEN=$TOKEN"    >> docker/.env   # 判题机容器读这里，两边必须一致

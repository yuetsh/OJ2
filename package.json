{
  "name": "oj2",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:worker dev:web",
    "dev:api": "bun run --filter '@oj2/api' dev:http",
    "dev:worker": "bun run --filter '@oj2/api' dev:worker",
    "dev:web": "bun run --filter '@oj2/web' dev",
    "seed:dev": "bun run --filter '@oj2/api' seed:dev",
    "db:up": "docker compose -f docker/compose.dev.yml up -d",
    "db:generate": "bun run --filter '@oj2/api' db:generate",
    "db:migrate": "bun run --filter '@oj2/api' db:migrate",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "vite-plus": "^1.0.0-rc.1"
  }
}

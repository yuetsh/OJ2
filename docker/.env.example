# 部署用的环境变量。拷成 .env（服务器）或 .env.school（机房）后填。
#
#   cp docker/.env.example docker/.env
#
# 仓库里不留任何真实密钥。带 `:?` 的变量没设置时 docker compose 会直接报错退出，
# 不会静默起一个用弱默认值的服务。

# 数据库口令。机房那套连的是服务器的库，两边必须一致。
# 这个账号是超级用户、5445 对公网开着（机房要连），必须是强口令，自己生成：
#   openssl rand -hex 32
# 它只在库第一次初始化时生效，之后改这里不会改库里的口令 —— 要换得进库 ALTER ROLE。
POSTGRES_PASSWORD=

# 判题机 token。后端和判题机容器读的是同一个变量，自己生成：
#   openssl rand -hex 32
OJ2_JUDGE_TOKEN=

# Redis 口令。会话存在 Redis 里，能连上它就能伪造任意用户（包括超管）的登录态，
# 所以必须设。它会拼进 REDIS_URL，只能用 URL 安全的字符，自己生成：
#   openssl rand -hex 32
# 服务器上本栈的 oj-redis 直接用它。
# 机房的 redis 不发布端口，只在 compose 网络里，不需要设。
REDIS_PASSWORD=

# 判题并发。受判题沙箱能力限制，不是越大越好。
# 服务器 2，机房机器宽裕可以给 4。
JUDGE_CONCURRENCY=2
# 试运行（运行例子 / 自己输入 / 后台生成测试点）同时占判题沙箱几路，和上面那个叠加。
# 不设时服务器 2、机房 4。
# TRIAL_CONCURRENCY=2

# DeepSeek key，用于题解 AI 分析。留空则 AI 功能不可用（其余功能不受影响）。
AI_KEY=

# AI 提示走两段式（先诊断、再生成）。填 1 打开，留空为关。
# 服务器和机房共用一个库、各有各的 .env —— 两边要一起开关，不然 ai_hint 里两种口径的数据混在一起。
AI_HINT_DIAGNOSE=

# --- 数据在哪 ---
#
# DATA_DIR 是所有数据卷的根（库、redis、测试点、上传的图片、判题机日志）。
# **不设的话默认是 `../data`，也就是 `OJ2/data` —— 不是部署目录的 `data/`。**
# 服务器上写成：
#
#   DATA_DIR=/root/OJDeploy/data
#
# 不设它就等于开一套空数据：空库（站点没有用户没有题）、没有测试点、题面图片 404。
DATA_DIR=

# --- 可选 ---
#
# 对外端口，不设是 8080（机房 81）。改了的话 NPM 那边的记录要跟着改，
# **NPM 的记录要打开 Websockets Support**，否则学生那边「判题中…」永远不动。
WEB_PORT=

# 判题机的运行状态目录（log/、run/），不设是 `$DATA_DIR/judge_server`。
# 换目录记得先 `mkdir -p .../{log,run}`。
JUDGE_STATE_DIR=

# --- 只有机房那套需要 ---
# 机房没有本地库，连服务器的 5445。不填时默认指向服务器（默认值在 compose.school.yml 里），
# 换服务器才要填。服务器那套不读这两个。
DB_HOST=
DB_PORT=

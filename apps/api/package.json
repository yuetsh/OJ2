{
  "name": "@oj2/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:http dev:worker",
    "dev:http": "bun --watch src/main.ts serve",
    "dev:worker": "bun --watch src/main.ts worker",
    "start": "bun src/main.ts serve",
    "worker": "bun src/main.ts worker",
    "build": "bun build --compile --bytecode --format=esm --target=bun-linux-x64 src/main.ts --outfile ../../dist/oj2-api",
    "seed:dev": "bun src/scripts/seed-dev.ts",
    "recount": "bun --env-file=../../.env src/main.ts recount",
    "rediagnose": "bun --env-file=../../.env src/main.ts rediagnose",
    "typecheck": "bun check",
    "check:routes": "bun src/scripts/check-route-shadowing.ts",
    "check:ast": "bun src/scripts/check-ast-targets.ts",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/main.ts migrate"
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.4",
    "@node-rs/jieba-linux-x64-gnu": "2.0.4",
    "@oj2/contract": "workspace:*",
    "bullmq": "^6.7.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "ioredis": "^6.0.0",
    "pinyin-pro": "3.29.5",
    "postgres": "^3.4.9",
    "sql.js": "^1.15.2",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
